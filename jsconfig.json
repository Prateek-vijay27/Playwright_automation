{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "pages/**/*.js",
    "fixture/**/*.js",
    "utils/**/*.js",
    "tests/**/*.js",
    "playwright.config.js"
  ],
  "exclude": [
    "node_modules",
    "playwright-report",
    "test-results",
    "allure-results"
  ]
}
